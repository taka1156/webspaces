{
  "name": "webspaces",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "sync": "node scripts/sync-r2-assets.mjs",
    "dev": "vite dev --port 3000",
    "build": "vite build && rm -rf out && cp -r dist/client out",
    "start": "vite preview",
    "deploy": "vinext-cloudflare deploy",
    "lint": "eslint 'src/**/*.{ts,tsx}' && yarn format",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' && yarn format",
    "format": "yarn prettier --check 'src/**/*.{ts,tsx}'",
    "format:fix": "yarn prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test-update": "vitest --update",
    "storybook": "storybook dev -p 8000",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@shikijs/langs": "^4.4.1",
    "@shikijs/themes": "^4.4.1",
    "@vinext/cloudflare": "^1.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.10",
    "github-markdown-css": "^5.4.0",
    "marked": "^18.0.6",
    "marked-alert": "^2.1.2",
    "marked-shiki": "^1.2.1",
    "next": "16.2.9",
    "normalize.css": "^8.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-scroll": "^1.9.0",
    "react-server-dom-webpack": "^19.3.0",
    "react-transition-group": "^4.4.5",
    "shiki": "^4.3.1",
    "usehooks-ts": "^3.1.1",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/cli": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-scroll": "^1.8.10",
    "@types/react-transition-group": "^4.4.9",
    "@vanilla-extract/css": "^1.16.0",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "cf": "^1.0.0-beta.14",
    "commitizen": "^4.3.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cz-customizable": "^7.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "inquirer": "^11.0.2",
    "jsdom": "^25.0.0",
    "knip": "^6.31.0",
    "prettier": "^3.2.5",
    "storybook": "^10.6.1",
    "typescript": "^5",
    "typescript-eslint": "^8.62.1",
    "vite": "8.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "yarn-audit-fix": "^10.1.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  },
  "resolutions": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "yarn@4.17.0",
  "type": "module"
}
